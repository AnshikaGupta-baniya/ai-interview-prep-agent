{
  "expo": {
    "name": "PrepAI",
    "slug": "prepai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "prepai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow PrepAI to access your microphone for recording answers."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Never"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.prepai"
    },
    "android": {
      "package": "com.yourname.prepai",
      "adaptiveIcon": {
        "backgroundColor": "#16141E"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "url": "https://u.expo.dev/6eae0e98-b269-4660-b582-faeb0a6b4d3a"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6eae0e98-b269-4660-b582-faeb0a6b4d3a"
      }
    }
  }
}
