{
  "expo": {
    "name": "YourNext",
    "slug": "yournext",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "YourNext",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow YourNext to access your microphone for recording answers."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Never"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.yournext"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8FC"
      },
      "package": "com.yourname.yournext",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "962cee4e-5652-40f4-ab5c-2d6c772b729e"
      }
    },
    "owner": "anshika_gupta_baniya"
  }
}
