services:
  - type: web
    name: interview-agent-api
    runtime: python
    rootDir: apps/backend
    buildCommand: pip install -r requirements.txt && python -c "from fastembed import TextEmbedding; TextEmbedding(model_name='fast-bge-small-en')"
    startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT
    envVars:
      - key: ENVIRONMENT
        value: production